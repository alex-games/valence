#!/bin/sh
#
# Create the nautilus_craft database and the craft role after Buildroot's
# S50postgresql has initialised and started the cluster. The game binary creates
# its own tables and seeds assets, so this script only owns role + database.
#
DB=nautilus_craft
ROLE=craft
PASS=craft

printf "Preparing %s: " "$DB"
for _ in $(seq 1 30); do
    /usr/bin/pg_isready -q -h 127.0.0.1 -p 5432 && break
    sleep 1
done
if ! /usr/bin/pg_isready -q -h 127.0.0.1 -p 5432; then
    echo "postgres did not answer"
    exit 0
fi

su - postgres -c "/usr/bin/psql -tAc \"SELECT 1 FROM pg_roles WHERE rolname='$ROLE'\"" 2>/dev/null | grep -q 1 || \
    su - postgres -c "/usr/bin/psql -c \"CREATE ROLE $ROLE LOGIN PASSWORD '$PASS'\""
su - postgres -c "/usr/bin/psql -tAc \"SELECT 1 FROM pg_database WHERE datname='$DB'\"" 2>/dev/null | grep -q 1 || \
    su - postgres -c "/usr/bin/createdb -O $ROLE $DB"
su - postgres -c "/usr/bin/psql -d $DB -c 'GRANT ALL ON SCHEMA public TO $ROLE'" >/dev/null 2>&1 || true
echo "OK"
