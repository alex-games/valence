#!/bin/sh
#
# Vault holds the **user game state** for every player, plus the per-player
# Bitcoin testnet wallet. PostgreSQL holds the sidechain (edits, accounts, shard
# tips, anchors). Both live under /var/lib and are therefore in the warm-boot
# snapshot.
#
# **File backend, not `-dev`.** Dev mode is in-memory; a warm boot would restore
# an empty Vault and every player would lose their state. The first boot
# initialises Vault and unseals it; later boots read the same init file.
#
# The game server does not get the root token: S47 creates a scoped token that
# can only touch secret/data/nautilus/* and stores it at game-token (0600). The
# root token remains on the guest (0600) for S47's own policy/token
# administration, so this is still a demo posture: a real deployment uses a
# separate unseal custodian and TLS.
#
DAEMON=/usr/bin/vault
PID=/var/run/vault.pid
LOG=/var/log/vault.log
CONFIG=/etc/vault/vault.hcl
STATE=/var/lib/vault
INIT="$STATE/init.json"
TOKEN_FILE="$STATE/root-token"
GAME_TOKEN_FILE="$STATE/game-token"
POLICY_FILE=/etc/vault/nautilus-game.hcl
export VAULT_ADDR=http://127.0.0.1:8200

# Normalize either the JSON form or Vault's human `operator init` output into
# the one JSON shape this script stores. Vault 1.17.0-beta1 ignored
# `-format=json` in this buildroot, so the text form is the real one.
normalize_init() {
    f="${1:-$INIT}"
    python3 - "$f" <<'PY'
import json, re, sys
raw = open(sys.argv[1], encoding="utf-8", errors="replace").read()
try:
    data = json.loads(raw)
    print(json.dumps({
        "root_token": data["root_token"],
        "unseal_keys_b64": [data["unseal_keys_b64"][0]],
    }))
    raise SystemExit(0)
except Exception:
    pass
unseal = re.search(r"Unseal Key 1:\s*(\S+)", raw)
token = re.search(r"Initial Root Token:\s*(\S+)", raw)
if not unseal or not token:
    raise SystemExit(1)
print(json.dumps({
    "root_token": token.group(1),
    "unseal_keys_b64": [unseal.group(1)],
}))
PY
}

init_valid() {
    f="${1:-$INIT}"
    [ -s "$f" ] || return 1
    python3 - "$f" <<'PY' >/dev/null 2>&1
import json, sys
data = json.load(open(sys.argv[1]))
assert data["root_token"]
assert data["unseal_keys_b64"][0]
PY
}

# The game server must not hold the root token. Create a scoped, non-expiring
# token that can only touch the nautilus KV paths; the root token stays in
# init.json for S47's own policy/token administration. The token file lives in
# /var/lib and is therefore restored with the warm snapshot.
ensure_game_token() {
    root_token="$1"
    mkdir -p /etc/vault
    # Rewrite on every boot so a policy update ships with the image rather than
    # being masked by an old file restored from the snapshot.
    cat > "$POLICY_FILE" <<'HCL'
path "secret/data/nautilus/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}
path "secret/metadata/nautilus/*" {
  capabilities = ["read", "list", "delete"]
}
HCL
    VAULT_TOKEN="$root_token" "$DAEMON" policy write nautilus-game "$POLICY_FILE" \
        >>"$LOG" 2>&1 || return 1

    if [ -s "$GAME_TOKEN_FILE" ]; then
        if VAULT_TOKEN=$(cat "$GAME_TOKEN_FILE") "$DAEMON" token lookup \
            >/dev/null 2>&1; then
            return 0
        fi
        echo "scoped game token is invalid; recreating"
        rm -f "$GAME_TOKEN_FILE"
    fi

    tmp="$GAME_TOKEN_FILE.tmp"
    VAULT_TOKEN="$root_token" "$DAEMON" token create \
        -policy=nautilus-game -orphan -ttl=0 \
        -display-name=nautilus-game -format=json >"$tmp" 2>>"$LOG" || {
        rm -f "$tmp"
        return 1
    }
    # Vault 1.17.0-beta1 in this buildroot can ignore -format=json, so accept
    # both the JSON token and the human table.
    t=$(python3 - "$tmp" <<'PY'
import json, re, sys
raw = open(sys.argv[1], encoding="utf-8", errors="replace").read()
try:
    print(json.loads(raw)["auth"]["client_token"])
except Exception:
    m = re.search(r"(?m)^token\s+(\S+)$", raw)
    if not m:
        raise SystemExit(1)
    print(m.group(1))
PY
) || {
        rm -f "$tmp"
        return 1
    }
    printf '%s\n' "$t" >"$GAME_TOKEN_FILE"
    chmod 600 "$GAME_TOKEN_FILE"
    rm -f "$tmp"
    return 0
}

start_vault() {
    mkdir -p "$STATE/data" /var/log
    chmod 700 "$STATE"

    # **An invalid init file used to be permanent.** The first failed
    # `vault operator init` left a 665-byte non-JSON file, and every later boot
    # skipped initialisation because the file existed; the server was then
    # initialized-but-sealed forever. Validate before starting. A missing key
    # next to non-empty storage is unrecoverable by design, so move that storage
    # aside and start a fresh demo store rather than serving a sealed one.
    if [ -f "$INIT" ] && ! init_valid; then
        echo "init file is not JSON; trying the human operator-init form"
        if normalize_init "$INIT" >"$INIT.recovered" 2>/dev/null && init_valid "$INIT.recovered"; then
            mv "$INIT" "$INIT.bad.$(date +%s)"
            mv "$INIT.recovered" "$INIT"
            chmod 600 "$INIT"
            echo "recovered the unseal key and root token from the human output"
        else
            rm -f "$INIT.recovered"
            echo "invalid init file; moving the old file aside"
            mv "$INIT" "$INIT.bad.$(date +%s)" 2>/dev/null || rm -f "$INIT"
        fi
    fi
    if [ ! -f "$INIT" ] && [ -d "$STATE/data" ] && [ -n "$(ls -A "$STATE/data" 2>/dev/null)" ]; then
        echo "no unseal key for existing storage; moving data aside"
        mv "$STATE/data" "$STATE/data.bad.$(date +%s)" 2>/dev/null || true
        mkdir -p "$STATE/data"
    fi

    start-stop-daemon -S -q -b -m -p "$PID" -x "$DAEMON" -- \
        server -config="$CONFIG" >>"$LOG" 2>&1

    # `vault status` exits 2 while sealed, so its exit status is not the
    # readiness signal. Wait for the status text, then init/unseal.
    i=0
    while [ "$i" -lt 30 ]; do
        if "$DAEMON" status 2>&1 | grep -q "Initialized"; then break; fi
        i=$((i + 1))
        sleep 1
    done

    if [ ! -f "$INIT" ]; then
        tmp="$INIT.tmp"
        "$DAEMON" operator init -key-shares=1 -key-threshold=1 -format=json \
            >"$tmp" 2>>"$LOG" || {
            rm -f "$tmp"
            echo "FAIL (init; see $LOG)"
            return 1
        }
        if ! init_valid "$tmp"; then
            if normalize_init "$tmp" >"$tmp.norm" 2>/dev/null && init_valid "$tmp.norm"; then
                mv "$tmp.norm" "$tmp"
            else
                mv "$tmp" "$INIT.bad.init" 2>/dev/null || true
                rm -f "$tmp.norm"
                echo "FAIL (init output is not JSON or operator-init text; see $LOG)"
                return 1
            fi
        fi
        mv "$tmp" "$INIT"
        chmod 600 "$INIT"
    fi

    TOKEN=$(INIT_PATH="$INIT" python3 -c 'import json,os;print(json.load(open(os.environ["INIT_PATH"]))["root_token"])' 2>>"$LOG")
    UNSEAL=$(INIT_PATH="$INIT" python3 -c 'import json,os;print(json.load(open(os.environ["INIT_PATH"]))["unseal_keys_b64"][0])' 2>>"$LOG")
    if [ -z "$TOKEN" ] || [ -z "$UNSEAL" ]; then
        echo "FAIL (init file unreadable)"
        return 1
    fi
    printf '%s\n' "$TOKEN" >"$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"

    # Unseal is idempotent; a sealed server must be unsealed before the mount.
    "$DAEMON" operator unseal "$UNSEAL" >>"$LOG" 2>&1 || {
        echo "FAIL (unseal; see $LOG)"
        return 1
    }

    # KV v2 at secret/ is the game-state path. Enable after unseal; an already
    # enabled mount returns an error that is safe to ignore.
    VAULT_TOKEN="$TOKEN" "$DAEMON" secrets enable -path=secret kv-v2 \
        >>"$LOG" 2>&1 || true
    if ! ensure_game_token "$TOKEN"; then
        echo "FAIL (scoped game token; see $LOG)"
        return 1
    fi

    if "$DAEMON" status 2>&1 | grep -q "Sealed.*true"; then
        echo "FAIL (still sealed; see $LOG)"
        return 1
    fi
    echo "OK (file backend; user state at secret/nautilus/game)"
    return 0
}

case "$1" in
  start)
    printf "Starting vault: "
    start_vault
    ;;
  stop)
    printf "Stopping vault: "
    start-stop-daemon -K -q -p "$PID" 2>/dev/null || true
    echo "OK"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  unseal)
    # Warm boot does not run init, so the host calls this after restoring the
    # sealed Vault snapshot. It is idempotent.
    printf "Unsealing vault: "
    if [ ! -r "$INIT" ]; then
        echo "FAIL (no $INIT)"
        exit 1
    fi
    UNSEAL=$(INIT_PATH="$INIT" python3 -c 'import json,os;print(json.load(open(os.environ["INIT_PATH"]))["unseal_keys_b64"][0])' 2>/dev/null)
    if [ -z "$UNSEAL" ]; then
        echo "FAIL (no unseal key)"
        exit 1
    fi
    "$DAEMON" operator unseal "$UNSEAL" >>"$LOG" 2>&1 || {
        echo "FAIL (see $LOG)"
        exit 1
    }
    if "$DAEMON" status 2>&1 | grep -q "Sealed.*true"; then
        echo "FAIL (still sealed)"
        exit 1
    fi
    TOKEN=$(INIT_PATH="$INIT" python3 -c 'import json,os;print(json.load(open(os.environ["INIT_PATH"]))["root_token"])' 2>/dev/null)
    if [ -z "$TOKEN" ] || ! ensure_game_token "$TOKEN"; then
        echo "FAIL (scoped game token)"
        exit 1
    fi
    echo "OK (sealed=false; scoped token)"
    ;;
  warmboot)
    # Warm restore: start Vault in the background and return immediately. The
    # caller polls `vault status` for Sealed=false; the serial line must not
    # block on Vault's startup.
    printf "Warming vault: "
    if [ ! -r "$INIT" ]; then
        echo "FAIL (no $INIT)"
        exit 1
    fi
    ( start_vault >/tmp/vault-warmboot.log 2>&1 ) &
    echo "started in background"
    ;;
  coldboot)
    # Cold capture: the data must already be initialised, and the daemon must be
    # gone before the state save. A live Vault in the snapshot is D62/D78.
    printf "Cold-booting vault: "
    if [ ! -r "$INIT" ]; then
        echo "FAIL (no $INIT; Vault was never initialised)"
        exit 1
    fi
    start-stop-daemon -K -q -p "$PID" 2>/dev/null || true
    i=0
    while [ "$i" -lt 20 ]; do
        /bin/ps -ef | /bin/grep -q '[v]ault server' || break
        i=$((i + 1))
        sleep 1
    done
    if /bin/ps -ef | /bin/grep -q '[v]ault server'; then
        echo "FAIL (Vault still running)"
        exit 1
    fi
    echo "OK (data initialised; daemon stopped for capture)"
    ;;
  status)
    "$DAEMON" status
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status|unseal|warmboot|coldboot}"
    exit 1
    ;;
esac
