#!/bin/sh
#
# Vault holds the **user game state** for every player, plus the per-player
# Bitcoin testnet wallet. PostgreSQL holds the sidechain (edits, accounts, shard
# tips, anchors). Both live under /var/lib and are therefore in the warm-boot
# snapshot.
#
# **File backend, not `-dev`.** Dev mode is in-memory; a warm boot would restore
# an empty Vault and every player would lose their state. The first boot
# initialises Vault and unseals it; later boots read the same init file.
#
# This is still a demo posture: the unseal key and root token live on the guest
# (0600), and the listener is loopback-only. A real deployment uses a separate
# unseal custodian and TLS.
#
DAEMON=/usr/bin/vault
PID=/var/run/vault.pid
LOG=/var/log/vault.log
CONFIG=/etc/vault/vault.hcl
STATE=/var/lib/vault
INIT="$STATE/init.json"
TOKEN_FILE="$STATE/root-token"
export VAULT_ADDR=http://127.0.0.1:8200

init_valid() {
    f="${1:-$INIT}"
    [ -s "$f" ] || return 1
    python3 - "$f" <<'PY' >/dev/null 2>&1
import json, sys
data = json.load(open(sys.argv[1]))
assert data["root_token"]
assert data["unseal_keys_b64"][0]
PY
}

start_vault() {
    mkdir -p "$STATE/data" /var/log
    chmod 700 "$STATE"

    # **An invalid init file used to be permanent.** The first failed
    # `vault operator init` left a 665-byte non-JSON file, and every later boot
    # skipped initialisation because the file existed; the server was then
    # initialized-but-sealed forever. Validate before starting. A missing key
    # next to non-empty storage is unrecoverable by design, so move that storage
    # aside and start a fresh demo store rather than serving a sealed one.
    if [ -f "$INIT" ] && ! init_valid; then
        echo "invalid init file; moving the old file aside"
        mv "$INIT" "$INIT.bad.$(date +%s)" 2>/dev/null || rm -f "$INIT"
    fi
    if [ ! -f "$INIT" ] && [ -d "$STATE/data" ] && [ -n "$(ls -A "$STATE/data" 2>/dev/null)" ]; then
        echo "no unseal key for existing storage; moving data aside"
        mv "$STATE/data" "$STATE/data.bad.$(date +%s)" 2>/dev/null || true
        mkdir -p "$STATE/data"
    fi

    start-stop-daemon -S -q -b -m -p "$PID" -x "$DAEMON" -- \
        server -config="$CONFIG" >>"$LOG" 2>&1

    # `vault status` exits 2 while sealed, so its exit status is not the
    # readiness signal. Wait for the status text, then init/unseal.
    i=0
    while [ "$i" -lt 30 ]; do
        if "$DAEMON" status 2>&1 | grep -q "Initialized"; then break; fi
        i=$((i + 1))
        sleep 1
    done

    if [ ! -f "$INIT" ]; then
        tmp="$INIT.tmp"
        "$DAEMON" operator init -key-shares=1 -key-threshold=1 -format=json \
            >"$tmp" 2>>"$LOG" || {
            rm -f "$tmp"
            echo "FAIL (init; see $LOG)"
            return 1
        }
        if ! init_valid "$tmp"; then
            mv "$tmp" "$INIT.bad.init" 2>/dev/null || true
            echo "FAIL (init output is not JSON; see $LOG)"
            return 1
        fi
        mv "$tmp" "$INIT"
        chmod 600 "$INIT"
    fi

    TOKEN=$(INIT_PATH="$INIT" python3 -c 'import json,os;print(json.load(open(os.environ["INIT_PATH"]))["root_token"])' 2>>"$LOG")
    UNSEAL=$(INIT_PATH="$INIT" python3 -c 'import json,os;print(json.load(open(os.environ["INIT_PATH"]))["unseal_keys_b64"][0])' 2>>"$LOG")
    if [ -z "$TOKEN" ] || [ -z "$UNSEAL" ]; then
        echo "FAIL (init file unreadable)"
        return 1
    fi
    printf '%s\n' "$TOKEN" >"$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"

    # Unseal is idempotent; a sealed server must be unsealed before the mount.
    "$DAEMON" operator unseal "$UNSEAL" >>"$LOG" 2>&1 || {
        echo "FAIL (unseal; see $LOG)"
        return 1
    }

    # KV v2 at secret/ is the game-state path. Enable after unseal; an already
    # enabled mount returns an error that is safe to ignore.
    VAULT_TOKEN="$TOKEN" "$DAEMON" secrets enable -path=secret kv-v2 \
        >>"$LOG" 2>&1 || true

    if "$DAEMON" status 2>&1 | grep -q "Sealed.*true"; then
        echo "FAIL (still sealed; see $LOG)"
        return 1
    fi
    echo "OK (file backend; user state at secret/nautilus/game)"
    return 0
}

case "$1" in
  start)
    printf "Starting vault: "
    start_vault
    ;;
  stop)
    printf "Stopping vault: "
    start-stop-daemon -K -q -p "$PID" 2>/dev/null || true
    echo "OK"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    "$DAEMON" status
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
